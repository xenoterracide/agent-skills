{
  "name": "@xenoterracide/agents",
  "version": "26.11.2",
  "packageManager": "pnpm@12.16.1",
  "private": true,
  "type": "module",
  "main": "index.js",
  "license": "CC-BY-NC-SA-4.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/node": "26",
    "eslint": "^10.14.0",
    "git-conventional-commits": "^2.8.0",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-java": "^2.7.5",
    "prettier-plugin-properties": "^0.3.0",
    "prettier-plugin-toml": "^4.0.0",
    "rimraf": "^6.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "contribute": "sh .config/git/hooks/heal.sh",
    "evals": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint:eslint && pnpm skills:check && pnpm test",
    "lint": "pnpm lint:eslint && pnpm lint:prettier && pnpm lint:reuse && pnpm skills:check",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --ignore-unknown --cache --check '**'",
    "lint:reuse": "pnpm reuse lint",
    "reuse": "uv run --frozen --group dev reuse",
    "skills:catalog": "node scripts/generate-skill-catalog.mjs",
    "skills:check": "node scripts/generate-skill-catalog.mjs --check",
    "test": "node --test scripts/*.test.mjs && vitest run scripts",
    "test:opencode": "node --test scripts/opencode-plugin.test.mjs"
  }
}
