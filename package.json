{
  "name": "@xenoterracide/agents",
  "version": "0.10.1",
  "packageManager": "pnpm@12.16.1",
  "private": true,
  "type": "module",
  "main": "index.js",
  "license": "Apache-2.0",
  "devDependencies": {
    "@prettier/plugin-xml": "^3.4.2",
    "@types/node": "v24",
    "git-conventional-commits": "^2.8.0",
    "lint-staged": "^17.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-java": "^2.7.5",
    "prettier-plugin-properties": "^0.3.0",
    "prettier-plugin-toml": "^2.0.6",
    "rimraf": "^6.1.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "contribute": "pnpm setup:corepack && pnpm setup:pnpm && uv sync --frozen && git config core.hooksPath .share/git/hooks",
    "evals": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm lint:prettier && pnpm lint:reuse && pnpm skills:check",
    "lint:prettier": "prettier --ignore-unknown --cache --check '**'",
    "lint:reuse": "pnpm reuse lint",
    "reuse": "uv run --frozen --group dev reuse",
    "setup:corepack": "npm install -g corepack && corepack enable --install-directory ~/.local/bin",
    "setup:pnpm": "pnpm install --frozen-lockfile",
    "skills:catalog": "node scripts/generate-skill-catalog.mjs",
    "skills:check": "node scripts/generate-skill-catalog.mjs --check",
    "test": "node --test scripts/*.test.mjs",
    "test:opencode": "node --test scripts/opencode-plugin.test.mjs"
  }
}
