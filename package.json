{
  "name": "@xenoterracide/agents",
  "version": "0.10.0",
  "packageManager": "yarn@4.18.1",
  "private": true,
  "type": "module",
  "main": "index.js",
  "license": "Apache-2.0",
  "devDependencies": {
    "@prettier/plugin-xml": "^3.4.2",
    "git-conventional-commits": "^2.8.0",
    "lint-staged": "^17.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-java": "^2.7.5",
    "prettier-plugin-properties": "^0.3.0",
    "prettier-plugin-toml": "^2.0.6",
    "rimraf": "^6.1.2",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "contribute": "uv sync --frozen && git config core.hooksPath .share/git/hooks",
    "evals": "node scripts/run-evals.mjs",
    "lint": "yarn lint:prettier && yarn lint:reuse && yarn skills:check",
    "lint:prettier": "prettier --ignore-unknown --cache --check '**'",
    "lint:reuse": "yarn reuse lint",
    "precontribute": "yarn setup:corepack && yarn setup:yarn",
    "reuse": "uv run --frozen --group dev reuse",
    "setup:corepack": "npm install -g corepack && corepack enable",
    "setup:yarn": "yarn install --immutable",
    "skills:catalog": "yarn node scripts/generate-skill-catalog.mjs",
    "skills:check": "yarn node scripts/generate-skill-catalog.mjs --check",
    "test": "node --test scripts/*.test.mjs",
    "test:opencode": "node --test scripts/opencode-plugin.test.mjs"
  }
}
